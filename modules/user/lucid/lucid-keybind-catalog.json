      "desc": "Wallpaper picker",
      "category": "Lucid"
    },
    {
      "id": "wallpaper-random",
      "keys": "SUPER + SHIFT + W",
      "desc": "Set a random wallpaper",
      "category": "Desktop"
    },
    {
