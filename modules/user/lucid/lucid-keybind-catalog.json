      "category": "Workspaces",
      "type": "lua",
      "lua": "specials.toggle('music')"
    },
    {
      "id": "special-comms",
      "keys": "SUPER + ALT + C",
      "desc": "Toggle Comms workspace",
      "category": "Workspaces",
      "type": "lua",
      "lua": "specials.toggle('comms')"
    },
    {
