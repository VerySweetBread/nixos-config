      "keys": "SUPER + SHIFT + {key}",
      "desc": "Move window to workspace {n}",
      "category": "Workspaces",
      "each": "workspace"
    },
    {
      "id": "scratchpad",
      "keys": "SUPER + ALT + P",
      "desc": "Toggle scratchpad",
      "category": "Workspaces",
      "type": "lua",
      "lua": "specials.scratchpad()"
    },
    {
      "id": "scratchpad-stash",
      "keys": "SUPER + ALT + S",
      "desc": "Stash or restore the focused window",
      "category": "Workspaces",
      "type": "lua",
      "lua": "specials.stash()"
    },
    {
      "id": "special-music",
